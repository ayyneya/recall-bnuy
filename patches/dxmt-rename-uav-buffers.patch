diff --git a/src/d3d11/d3d11_buffer.cpp b/src/d3d11/d3d11_buffer.cpp
--- a/src/d3d11/d3d11_buffer.cpp
+++ b/src/d3d11/d3d11_buffer.cpp
@@ -22,6 +22,7 @@
 #include "dxmt_dynamic.hpp"
 #include "dxmt_format.hpp"
 #include "d3d11_resource.hpp"
+#include "util_env.hpp"
 
 namespace dxmt {
 
@@ -122,9 +123,27 @@
     allow_raw_view = pDesc->MiscFlags & D3D11_RESOURCE_MISC_BUFFER_ALLOW_RAW_VIEWS;
     if (!(desc.BindFlags & kD3D11OutputBindFlags)) {
       dynamic_ = new DynamicBuffer(buffer_.ptr(), flags);
+    } else if (RenameUAVBuffers() && pDesc->Usage == D3D11_USAGE_DEFAULT &&
+               (desc.BindFlags & kD3D11OutputBindFlags) == D3D11_BIND_UNORDERED_ACCESS &&
+               !(pDesc->MiscFlags & ~(D3D11_RESOURCE_MISC_DRAWINDIRECT_ARGS | D3D11_RESOURCE_MISC_BUFFER_ALLOW_RAW_VIEWS |
+                                      D3D11_RESOURCE_MISC_BUFFER_STRUCTURED))) {
+      // Pawpad (DXMT_RENAME_UAV_BUFFERS=1): a whole-buffer UpdateSubresource of a GPU-writable buffer
+      // gets a fresh CPU-writable name, like Map(DISCARD), instead of a staging copy in a blit encoder
+      // that splits the compute work around it. New names are Managed (shader-writable views, CPU
+      // writes on unified memory); the GPU-private first allocation is never handed out as a name.
+      auto rename_flags = flags;
+      rename_flags.clr(BufferAllocationFlag::GpuPrivate);
+      rename_flags.set(BufferAllocationFlag::GpuManaged);
+      dynamic_ = new DynamicBuffer(buffer_.ptr(), rename_flags);
     }
   }
 
+  static bool
+  RenameUAVBuffers() {
+    static const bool enabled = env::getEnvVar("DXMT_RENAME_UAV_BUFFERS") == "1";
+    return enabled;
+  }
+
   bool
   allocationRefused() const {
     return allocation_refused_;
diff --git a/src/dxmt/dxmt_dynamic.cpp b/src/dxmt/dxmt_dynamic.cpp
--- a/src/dxmt/dxmt_dynamic.cpp
+++ b/src/dxmt/dxmt_dynamic.cpp
@@ -30,8 +30,13 @@
     if (entry.will_free_at > coherent_seq_id) {
       break;
     }
-    ret = std::move(entry.allocation);
     fifo.pop();
+    // Pawpad: a GPU-writable buffer's first allocation is GPU-private (no CPU mapping); once renamed
+    // away it is dropped, not reused as a name the CPU writes into.
+    if (entry.allocation->flags().test(BufferAllocationFlag::GpuPrivate) &&
+        !flags_.test(BufferAllocationFlag::GpuPrivate))
+      continue;
+    ret = std::move(entry.allocation);
     break;
   }
   if (!ret.ptr())
