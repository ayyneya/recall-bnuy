diff --git a/src/nvngx/nvngx_parameter.hpp b/src/nvngx/nvngx_parameter.hpp
--- a/src/nvngx/nvngx_parameter.hpp
+++ b/src/nvngx/nvngx_parameter.hpp
@@ -115,9 +115,39 @@
 inline bool
 castable(unsigned int val, unsigned long long *out) {
   *out = (unsigned long long)val;
+  return true;
+}
+
+// Pawpad: Streamline (sl.dlss) hands NGX its D3D11 and D3D12 resources through the void * setter, and
+// they are read back as resources: the two convert both ways.
+template <>
+inline bool
+castable(void *val, ID3D11Resource **out) {
+  *out = static_cast<ID3D11Resource *>(val);
+  return true;
+}
+
+template <>
+inline bool
+castable(ID3D11Resource *val, void **out) {
+  *out = val;
   return true;
 }
 
+template <>
+inline bool
+castable(void *val, ID3D12Resource **out) {
+  *out = static_cast<ID3D12Resource *>(val);
+  return true;
+}
+
+template <>
+inline bool
+castable(ID3D12Resource *val, void **out) {
+  *out = val;
+  return true;
+}
+
