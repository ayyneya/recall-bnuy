+PassTimingReadback::~PassTimingReadback() {
+  unsigned n = (unsigned)labels_.size();
+  if (!n)
+    return;
+  std::vector<uint64_t> ticks(n);
+  sample_buffer_.resolveCounterRange(0, n, ticks.data(), n * sizeof(uint64_t));
+  std::lock_guard<std::mutex> lock(pass_timing_mutex);
+  if (!pass_timing_file) {
+    auto path = env::getEnvVar("DXMT_PASS_TIMING");
+    pass_timing_file = std::fopen(path.c_str(), "a");
+    if (!pass_timing_file)
+      return;
+  }
+  // the command buffer's own GPU start and end (ns) calibrate the sample ticks
+  std::fprintf(pass_timing_file, "CB %llu %llu %llu %llu %u\n", (unsigned long long)frame_, (unsigned long long)seq_,
+               (unsigned long long)cmdbuf_.gpuStartTime(), (unsigned long long)cmdbuf_.gpuEndTime(), n);
+  for (unsigned i = 0; i < n; i++)
+    std::fprintf(pass_timing_file, "P %llu %llu %u %llu %s\n", (unsigned long long)frame_, (unsigned long long)seq_, i,
+                 (unsigned long long)ticks[i], labels_[i].c_str());
+  std::fflush(pass_timing_file);
+}
