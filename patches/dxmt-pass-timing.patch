+// Pawpad diagnostics (DXMT_PASS_TIMING=<file>): a GPU timestamp before each encoder of a command
+// buffer and one after the last. Once the GPU has finished (the readback is destroyed on the
+// finish thread) every encoder's share of the command buffer is appended to the file.
+class PassTimingReadback {
+public:
+  static constexpr unsigned kMaxSamples = 4096;
+
+  PassTimingReadback(WMT::Device device, WMT::CommandBuffer cmdbuf, uint64_t frame, uint64_t seq, unsigned capacity) :
+      cmdbuf_(cmdbuf),
+      frame_(frame),
+      seq_(seq),
+      capacity_(capacity) {
+    sample_buffer_ = device.newCounterSampleBuffer(capacity, true);
+    labels_.reserve(capacity);
+  }
+  ~PassTimingReadback();
+
+  PassTimingReadback(const PassTimingReadback &) = delete;
+  PassTimingReadback(PassTimingReadback &&) = delete;
+
+  WMT::CounterSampleBuffer
+  sampleBuffer() {
+    return sample_buffer_;
+  }
+
+  // the index of the next sample, or ~0u when the buffer is full
+  unsigned
+  next() {
+    return labels_.size() < capacity_ ? (unsigned)labels_.size() : ~0u;
+  }
+
+  std::vector<std::string> labels_;
+
+private:
+  WMT::CommandBuffer cmdbuf_;
+  WMT::Reference<WMT::CounterSampleBuffer> sample_buffer_;
+  uint64_t frame_, seq_;
+  unsigned capacity_;
 };
 
 struct QueryReadbacks {
   std::unique_ptr<VisibilityResultReadback> visibility;
   std::unique_ptr<TimestampReadback> timestamp;
+  std::unique_ptr<PassTimingReadback> pass_timing;
 };
 
