+/**
+Recall: true when BYTECODE is a geometry shader that only passes each point through: point list in,
+point list out, at most one vertex, and every instruction a plain `mov o[N], v[0][N]` (same register,
+same components, no modifiers) before one emit. Stream output from such a shader is the vertex
+shader's own output, which the vertex stream-output emulation produces. Overwatch uses one for
+particle effects (Ana's sleep, Sombra's hack, mythic and Voidwalker skins, highlight intros).
+*/
+static bool
+IsPointPassThroughGeometryShader(const void *pShaderBytecode) {
+  auto p = (const uint8_t *)pShaderBytecode;
+  if (!p || memcmp(p, "DXBC", 4))
+    return false;
+  uint32_t total, count;
+  memcpy(&total, p + 24, 4);
+  memcpy(&count, p + 28, 4);
+  const uint32_t *code = nullptr;
+  uint32_t code_dwords = 0;
+  for (uint32_t i = 0; i < count && 32 + 4 * (i + 1) <= total; i++) {
+    uint32_t offset, size;
+    memcpy(&offset, p + 32 + 4 * i, 4);
+    if (offset + 8 > total)
+      return false;
+    memcpy(&size, p + offset + 4, 4);
+    if (offset + 8 + size > total)
+      return false;
+    if (!memcmp(p + offset, "SHDR", 4) || !memcmp(p + offset, "SHEX", 4)) {
+      code = (const uint32_t *)(p + offset + 8);
+      code_dwords = size / 4;
+    }
+  }
+  if (!code || code_dwords < 2 || (code[0] >> 16) != 2 /* geometry */)
+    return false;
+  uint32_t length = std::min(code[1], code_dwords);
+  uint32_t declared[32] = {}, written[32] = {};
+  bool point_in = false, point_out = false, one_vertex = false, emitted = false, returned = false;
+  for (uint32_t at = 2; at < length;) {
+    uint32_t token = code[at], opcode = token & 0x7ff, size = (token >> 24) & 0x7f;
+    if (opcode == 0x35 /* customdata */)
+      size = at + 1 < length ? code[at + 1] : 0;
+    if (!size || at + size > length || returned)
+      return false;
+    const uint32_t *op = code + at + 1;
+    switch (opcode) {
+    case 0x6a: // dcl_globalFlags
+    case 0x5f: // dcl_input
+    case 0x60: // dcl_input_siv
+    case 0x61: // dcl_input_sgv
+    case 0x68: // dcl_temps
+    case 0x35: // customdata (comments)
+      break;
+    case 0x8f: // dcl_stream m0
+      if (size != 3 || op[1] != 0)
+        return false;
+      break;
+    case 0x5d: // dcl_inputprimitive
+      point_in = ((token >> 11) & 0x3f) == 1;
+      break;
+    case 0x5c: // dcl_outputtopology
+      point_out = ((token >> 11) & 0x7f) == 1;
+      break;
+    case 0x5e: // dcl_maxvertexcount
+      one_vertex = size == 2 && op[0] == 1;
+      break;
+    case 0x65: // dcl_output
+    case 0x66: // dcl_output_sgv
+    case 0x67: // dcl_output_siv
+      // o[N] with a mask, one immediate index
+      if (size < 3 || ((op[0] >> 12) & 0xff) != 2 || ((op[0] >> 2) & 3) != 0 || (op[0] >> 31) || op[1] >= 32)
+        return false;
+      declared[op[1]] |= (op[0] >> 4) & 0xf;
+      break;
+    case 0x36: { // mov
+      if (emitted || (token & (1 << 13)) /* saturate */ || (token >> 31) || size != 6)
+        return false;
+      uint32_t dst = op[0], reg = op[1], src = op[2];
+      // dst: o[reg], 4 components, mask mode, 1D immediate index, no extended operand
+      if (((dst >> 12) & 0xff) != 2 || (dst & 3) != 2 || ((dst >> 2) & 3) != 0 || ((dst >> 20) & 3) != 1 ||
+          ((dst >> 22) & 7) != 0 || (dst >> 31) || reg >= 32)
+        return false;
+      // src: v[0][reg], 2D immediate indices, no extended operand (modifiers)
+      if (((src >> 12) & 0xff) != 1 || (src & 3) != 2 || ((src >> 20) & 3) != 2 || ((src >> 22) & 7) != 0 ||
+          ((src >> 25) & 7) != 0 || (src >> 31) || op[3] != 0 || op[4] != reg)
+        return false;
+      uint32_t mask = (dst >> 4) & 0xf, mode = (src >> 2) & 3;
+      for (uint32_t c = 0; c < 4; c++) {
+        if (!(mask & (1 << c)))
+          continue;
+        uint32_t from = mode == 0   ? c
+                        : mode == 1 ? (src >> (4 + 2 * c)) & 3
+                                    : (src >> 4) & 3;
+        if (from != c)
+          return false;
+      }
+      written[reg] |= mask;
+      break;
+    }
+    case 0x3f: // emit
+      if (emitted || size != 1)
+        return false;
+      emitted = true;
+      break;
+    case 0x75: // emit_stream m0
+      if (emitted || size != 3 || op[1] != 0)
+        return false;
+      emitted = true;
+      break;
+    case 0x3e: // ret
+      returned = true;
+      break;
+    default:
+      return false;
+    }
+    at += size;
+  }
+  if (!point_in || !point_out || !one_vertex || !emitted)
+    return false;
+  for (uint32_t reg = 0; reg < 32; reg++)
+    if ((declared[reg] & written[reg]) != declared[reg])
+      return false;
+  return true;
+}
