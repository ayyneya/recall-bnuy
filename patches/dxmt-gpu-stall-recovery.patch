 uint64_t
+ResourceInitializer::recoverLostSignals() {
+  std::lock_guard<dxmt::mutex> lock(mutex_);
+  // Upload buffers finish in commit order: once the last one has, all of them have.
+  if (last_upload_)
+    last_upload_.waitUntilCompleted();
+  uint64_t expected = current_seq_id_ - 1, signaled = upload_queue_event_.signaledValue();
+  if (signaled >= expected)
+    return 0;
+  upload_queue_event_.signalValue(expected);
+  cached_coherent_seq_id = expected;
+  return expected - signaled;
+}
